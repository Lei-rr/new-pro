{
  "name": "new-pro",
  "version": "1.2.0",
  "description": "NewAPI 高性能多维实时监控与风险分析系统",
  "packageManager": "pnpm@10.18.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm run dev:server",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:web": "pnpm --filter new-pro-web run dev",
    "start": "node dist/server.js",
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "pnpm --filter new-pro-web run build",
    "clean": "rm -rf dist web/dist",
    "typecheck": "tsc --noEmit && pnpm --filter new-pro-web run typecheck"
  },
  "dependencies": {
    "@fastify/compress": "^9.1.0",
    "@fastify/cookie": "^11.1.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.2.1",
    "ip2region": "^2.3.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
