    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.2",
    "@prometheus-io/client": "^0.16.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "fastify-type-provider-zod": "4.0.2",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
