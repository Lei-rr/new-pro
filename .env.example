# ── New-Pro (NewAPI Log Analytics) - 环境配置 ──

# 服务端口（默认 3600）
PORT=3600

# PostgreSQL：NewAPI 数据库（唯一数据源，只读使用）
SQL_DSN=postgresql://root:guolei0928@172.21.0.3:5432/new-api

# 业务时区（自然日窗口对齐；'local' = 容器本地时区，或 IANA 名如 Asia/Shanghai）
LOG_TZ=Asia/Shanghai

# 实时增量轮询间隔（毫秒）
POLL_INTERVAL_MS=1000

# 访问认证 Key（可选，多个 key 用逗号分隔；留空表示关闭认证）
API_KEYS=

# CORS 允许来源（逗号分隔；留空 = 仅同源；* = 允许所有来源）
CORS_ORIGINS=

# HTTP 限流（每 IP 每窗口最大请求数；0 = 关闭）
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# 告警阈值
ALERT_ERROR_RATE=0.1
ALERT_QUOTA_THRESHOLD=50000000
