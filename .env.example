# ── NewAPI Log Analytics - 环境配置 ──

# 服务端口（默认 3600）
PORT=3600

# 宿主机 NewAPI 日志目录（用于 docker-compose volume 挂载到容器 /logs）
LOG_PATH=/guolei/new-api/logs

# 本地非容器模式下的日志目录（Docker 模式无需配置，容器内默认读取 /logs）
# LOG_DIR=/guolei/new-api/logs

# 访问认证 Key（可选，多个 key 用逗号分隔；留空表示关闭认证）
API_KEYS=

# 内存上限与保留时长
MAX_ENTRIES=500000
RETENTION_HOURS=72
