# ── NewAPI Log Analytics - 环境配置 ──

# 服务端口与绑定
PORT=3600
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# 宿主机 NewAPI 日志目录（用于 docker-compose volume 挂载到容器 /logs）
LOG_PATH=/guolei/new-api/logs

# 应用程序内读取日志路径（Docker 模式下固定为 /logs，本地开发请填本机真实路径）
LOG_DIR=/logs
LOG_PATTERN=oneapi-*.log

# 访问认证 Key（可选，多个 key 用逗号分隔；留空表示关闭认证）
# HTTP: Authorization: Bearer <key> 或 X-API-Key: <key>
# WebSocket: ws://host:3600/ws?api_key=<key>
API_KEYS=

# 内存上限与保留时长
MAX_ENTRIES=500000
RETENTION_HOURS=72

# WebSocket 推送间隔
WS_STATS_INTERVAL_MS=3000
WS_LOGS_BATCH_MS=200
WS_LOGS_BATCH_SIZE=20

# 智能告警阈值
ALERT_IP_RATE_PER_MIN=100
ALERT_ERROR_RATE=0.1
ALERT_QUOTA_THRESHOLD=50000000
