# ==========================================
# New-Pro 环境变量示例
# 复制为 .env 并填入真实配置：cp .env.example .env
# ==========================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# 数据库连接（NewAPI 的 PostgreSQL 实例，必填）
DATABASE_URL=postgresql://root:your_db_password@new-api-postgres:5432/new-api
DB_POOL_MAX=20
# 单条 SQL 最大执行时间与慢查询告警阈值（毫秒）
DB_STATEMENT_TIMEOUT_MS=15000
SLOW_QUERY_WARN_MS=2000
# 优雅关闭最长等待时间（毫秒）
SHUTDOWN_TIMEOUT_MS=10000

# 控制台管理员凭据与会话
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now
# 会话签名密钥，务必替换为随机字符串：openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret
SESSION_TTL_SEC=604800
# 经 HTTPS 访问时开启，Cookie 将仅通过加密通道传输
COOKIE_SECURE=false

# 反向代理场景下开启，用于获取真实客户端 IP
TRUST_PROXY=false

# 允许跨域访问的来源，逗号分隔；同源或反向代理部署可留空
# CORS_ORIGINS=https://dashboard.example.com

# 接口限流
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
LOGIN_RATE_LIMIT_MAX=10

# 实时推流与全量校准周期（秒）
PULSE_INTERVAL_SEC=3
CALIBRATION_INTERVAL_SEC=60

# 聚合结果缓存（毫秒）
OVERVIEW_CACHE_TTL_MS=4000
# 3 天及以上区间需扫描全表，用更长 TTL 摊薄（默认 60 秒）
OVERVIEW_LONG_CACHE_TTL_MS=60000
DIMENSION_CACHE_TTL_MS=4000
RISK_CACHE_TTL_MS=5000

# 概览返回的已知 IP 上限（防止长期区间响应体积膨胀）
KNOWN_IP_LIST_LIMIT=2000

# Prometheus 指标端点（/api/system/metrics）
# 未配置令牌时仅允许内网抓取；配置后需携带 Authorization: Bearer <token>
# METRICS_TOKEN=

# IP 归属地：优先本地 ip2region 离线库，未命中才请求在线接口
GEO_LOOKUP_TIMEOUT_MS=1800
GEO_OFFLINE_ENABLED=true
GEO_ONLINE_ENABLED=true
# 在线查询每日上限，0 表示不限；建议保留默认值避免触发第三方限频
GEO_ONLINE_DAILY_QUOTA=2000
# 命中缓存与未命中缓存的保留时长（毫秒）
GEO_CACHE_TTL_MS=604800000
GEO_NEGATIVE_CACHE_TTL_MS=3600000
# 风控扫描需豁免的自定义内网/回环地址，逗号分隔
# INTERNAL_IP_LIST=10.0.0.5,192.168.1.10

# 风控阈值（可选，缺省即内置推荐值）
# 规则清单与优先级见 /api/system/diagnostics 的 riskRules 字段
# 扫描门槛与突发窗口
# RISK_IP_MIN_REQUESTS=20
# RISK_RELAY_PER_MINUTE=60
# RISK_RELAY_BURST_5M=200
# RISK_RELAY_CRITICAL_PER_MINUTE=90
# 恶意刷接口（周期口径）：请求≥200且失败率≥70%，或失败≥150且失败率≥60%
# RISK_BRUTE_FORCE_TOTAL=200
# RISK_BRUTE_FORCE_FAIL_RATE=70
# RISK_BRUTE_FORCE_FAILED_FLOOR=150
# RISK_BRUTE_FORCE_FAIL_RATE_LOW=60
# 恶意刷接口（突发口径）
# RISK_BRUSHING_BURST_5M=30
# RISK_BRUSHING_BURST_5M_FAIL_RATE=70
# RISK_BRUSHING_BURST_1M=20
# RISK_BRUSHING_BURST_1M_FAIL_RATE=75
# 风险升级为 critical 的通用阈值
# RISK_IP_CRITICAL_FAIL_RATE=85
# RISK_MASSIVE_VOLUME=5000
# RISK_MASSIVE_VOLUME_CRITICAL_FACTOR=2
# 渠道故障
# RISK_CHANNEL_MIN_REQUESTS=30
# RISK_CHANNEL_FAIL_RATE=50
# RISK_CHANNEL_CRITICAL_FAIL_RATE=80
# RISK_CHANNEL_HIGH_LATENCY_MS=15000
# RISK_CHANNEL_HIGH_LATENCY_FAIL_RATE=30
# 全局超时告警
# RISK_EXTREME_SLOW_MS=45000
# RISK_EXTREME_SLOW_COUNT=50
