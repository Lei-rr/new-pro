# ── NewAPI Log Analytics - 环境配置 ──

# 服务端口（默认 3600）
PORT=3600

# 宿主机 NewAPI 日志目录（用于 docker-compose volume 挂载到容器 /logs）
LOG_PATH=/guolei/new-api/logs

# 本地非容器模式下的日志目录（Docker 模式无需配置，容器内默认读取 /logs）
# LOG_DIR=/guolei/new-api/logs

# 日志源服务器时区（NewAPI 日志时间戳为无时区墙钟时间）
# 'local' = 与本进程同时区；否则填 IANA 时区名（如 Asia/Shanghai、UTC）
LOG_TZ=local

# 访问认证 Key（可选，多个 key 用逗号分隔；留空表示关闭认证）
API_KEYS=

# CORS 允许来源（逗号分隔；留空 = 仅同源；* = 允许所有来源）
CORS_ORIGINS=

# HTTP 限流（每 IP 每窗口最大请求数；0 = 关闭）
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# 内存上限与保留时长
MAX_ENTRIES=500000
RETENTION_HOURS=72
