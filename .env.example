# ==========================================
# New-Pro 运行环境变量配置示例
# 复制本文件为 .env 并填入真实配置即可生效：
# cp .env.example .env
# ==========================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3033
LOG_LEVEL=info

# 数据库连接 (指向 NewAPI 的 PostgreSQL 实例)
DATABASE_URL=postgresql://root:your_db_password@new-api-postgres:5432/new-api

# 控制台管理员登录用户名与密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 会话签名密钥 (建议生成随机字符串)
JWT_SECRET=your_jwt_secret_random_key_change_me

# 运行周期调优 (秒)
# 实时心跳推流间隔 (默认 3 秒)
PULSE_INTERVAL_SEC=3
# 全量图表与宏观校准间隔 (默认 60 秒)
CALIBRATION_INTERVAL_SEC=60
